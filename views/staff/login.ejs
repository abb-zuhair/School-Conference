<%- include('../partials/head', { narrow: true }) %>

<div class="card" style="max-width:430px;margin:40px auto">
  <h1>Staff sign in</h1>
  <p class="muted small">Teachers, department heads and administrators.</p>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>

  <% if (ssoEnabled) { %>
    <a class="btn ms-btn" href="/auth/microsoft">
      <svg width="17" height="17" viewBox="0 0 23 23" aria-hidden="true" focusable="false">
        <rect x="1"  y="1"  width="10" height="10" fill="#f25022"/>
        <rect x="12" y="1"  width="10" height="10" fill="#7fba00"/>
        <rect x="1"  y="12" width="10" height="10" fill="#00a4ef"/>
        <rect x="12" y="12" width="10" height="10" fill="#ffb900"/>
      </svg>
      Sign in with Microsoft
    </a>
    <p class="muted small" style="margin:10px 0 0">Use your school <span class="mono">@aca.edu.kw</span> account.</p>

    <div class="or-rule"><span>or use a password</span></div>
  <% } %>

  <form method="post" action="/staff/login">
    <div class="field">
      <label for="email">School email</label>
      <input id="email" name="email" type="email" required <%= ssoEnabled ? '' : 'autofocus' %> value="<%= email %>">
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" required>
    </div>
    <button class="btn <%= ssoEnabled ? 'ghost' : '' %>" type="submit" style="width:100%">Sign in</button>
  </form>

  <p class="muted small" style="margin-top:14px">Forgotten your password? Ask the IT office to reset it.</p>
</div>

<%- include('../partials/foot') %>
