<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %> · <%= config.schoolName %></title>
  <link rel="stylesheet" href="/static/css/app.css">
  <link rel="stylesheet" href="/branding/theme.css?v=<%= brand.version %>">
  <link rel="icon" href="<%= brand.logoUrl || h.faviconDataUrl() %>">
</head>
<body class="<%= bodyClass || '' %>">
<header class="site-header">
  <div class="bar">
    <a class="brand" href="/">
      <% if (brand.logoUrl) { %><img class="logo" src="<%= brand.logoUrl %>" alt=""><% } else { %><span class="mark"><%= brand.short %></span><% } %>
      <span><%= brand.name %></span>
    </a>
    <nav class="nav">
      <a href="/" class="<%= path === '/' ? 'on' : '' %>">Book an appointment</a>
      <a href="/lookup" class="<%= path === '/lookup' ? 'on' : '' %>">My appointments</a>
      <% if (user) { %>
        <% if (['admin','campus_admin'].includes(user.role)) { %><a href="/admin">Admin</a><% } %>
        <% if (user.role === 'dept_head') { %>
          <a href="/staff/department" class="<%= path.indexOf('/staff/department') === 0 ? 'on' : '' %>">My department</a>
        <% } %>
        <a href="/staff">My schedules</a>
        <form method="post" action="/staff/logout" style="display:inline">
          <button class="btn sm ghost" type="submit">Sign out</button>
        </form>
      <% } else { %>
        <a href="/staff/login">Staff sign in</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="wrap <%= typeof narrow !== 'undefined' && narrow ? 'narrow' : '' %>">
<%- include('flash') %>
