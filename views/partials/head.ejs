<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %> · <%= config.schoolName %></title>
  <link rel="stylesheet" href="/static/css/app.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%230b3d5c'/><text x='16' y='22' font-size='16' font-family='Arial' font-weight='bold' text-anchor='middle' fill='%23c8922a'>A</text></svg>">
</head>
<body class="<%= bodyClass || '' %>">
<header class="site-header">
  <div class="bar">
    <a class="brand" href="/"><span class="mark">ACA</span> <span><%= config.schoolName %></span></a>
    <nav class="nav">
      <a href="/" class="<%= path === '/' ? 'on' : '' %>">Book an appointment</a>
      <a href="/lookup" class="<%= path === '/lookup' ? 'on' : '' %>">My appointments</a>
      <% if (user) { %>
        <% if (['admin','campus_admin'].includes(user.role)) { %><a href="/admin">Admin</a><% } %>
        <a href="/staff">My schedules</a>
        <form method="post" action="/staff/logout" style="display:inline">
          <button class="btn sm ghost" type="submit">Sign out</button>
        </form>
      <% } else { %>
        <a href="/staff/login">Staff sign in</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="wrap <%= typeof narrow !== 'undefined' && narrow ? 'narrow' : '' %>">
<%- include('flash') %>
