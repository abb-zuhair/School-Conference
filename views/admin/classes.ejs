<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>

<div class="card">
  <div class="card-head">
    <div>
      <h1>Classes</h1>
      <div class="muted small"><%= classes.length %> class<%= classes.length === 1 ? '' : 'es' %> shown</div>
    </div>
    <div class="spacer"></div>
    <form method="get" action="/admin/classes" class="btn-row">
      <select name="campus" style="width:auto">
        <option value="">All campuses</option>
        <% campuses.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= filters.campus === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
      <select name="department" style="width:auto">
        <option value="">All departments</option>
        <% departments.forEach(function (d) { %>
          <option value="<%= d.id %>" <%= filters.department === d.id ? 'selected' : '' %>><%= d.name %></option>
        <% }); %>
      </select>
      <input name="q" value="<%= filters.q %>" placeholder="Search class or teacher" style="width:200px">
      <button class="btn sm ghost" type="submit">Filter</button>
      <% if (filters.campus || filters.department || filters.q) { %>
        <a class="btn sm ghost" href="/admin/classes">Clear</a>
      <% } %>
    </form>
  </div>

  <form method="post" action="/admin/classes/bulk" id="bulk-classes">
    <div class="bulk-bar" id="class-bulk-bar" hidden>
      <strong class="small"><span id="class-count">0</span> selected</strong>

      <label class="small">Move to teacher
        <select name="staff_id" style="width:auto">
          <option value="">Choose…</option>
          <% teachers.forEach(function (t) { %><option value="<%= t.id %>"><%= t.name %></option><% }); %>
        </select>
      </label>
      <button class="btn sm" type="submit" name="action" value="reassign">Move</button>

      <span class="bulk-sep"></span>

      <details class="bulk-danger">
        <summary class="btn sm danger">Delete…</summary>
        <div class="bulk-danger-body">
          <p class="small muted" style="margin:0 0 8px">Deleting a class also removes its schedules and slots in every event.</p>
          <div class="check">
            <input type="checkbox" id="cls_cancel" name="cancel_bookings" value="1">
            <label for="cls_cancel">Cancel their live bookings too</label>
          </div>
          <div class="check">
            <input type="checkbox" id="cls_notify" name="notify" value="1" checked>
            <label for="cls_notify">Tell the affected parents</label>
          </div>
          <button class="btn sm danger" type="submit" name="action" value="delete"
                  onclick="return confirm('Delete the selected classes?')">Delete selected classes</button>
        </div>
      </details>
    </div>

    <div class="table-wrap">
      <table class="data">
        <thead><tr>
          <th style="width:34px"><input type="checkbox" id="class-all" aria-label="Select all"></th>
          <th>Class</th><th>Teacher</th><th>Campus</th><th>Department</th><th>Grade</th><th>Room</th><th>Schedules</th><th>Booked</th><th></th>
        </tr></thead>
        <tbody>
          <% if (!classes.length) { %>
            <tr><td colspan="10" class="muted small">No classes match. Add them on a teacher's page, or import a CSV.</td></tr>
          <% } %>
          <% classes.forEach(function (c) { %>
            <tr style="<%= c.staff_active ? '' : 'opacity:.55' %>">
              <td><input type="checkbox" class="class-pick" name="class_ids" value="<%= c.id %>" form="bulk-classes"></td>
              <td><strong><%= c.name %></strong></td>
              <td>
                <a href="/admin/staff/<%= c.staff_id %>"><%= c.staff_name %></a>
                <% if (!c.staff_active) { %> <span class="badge muted">inactive</span><% } %>
              </td>
              <td class="small"><%= c.campus_name || '—' %></td>
              <td class="small"><%= c.department_name || '—' %></td>
              <td class="small"><%= c.grade_level || '' %></td>
              <td class="small"><%= c.room || '' %></td>
              <td><%= c.schedule_count %></td>
              <td><% if (c.booked > 0) { %><span class="badge ok"><%= c.booked %></span><% } else { %><span class="muted">0</span><% } %></td>
              <td style="text-align:end">
                <form method="post" action="/admin/classes/<%= c.id %>/delete" onsubmit="return confirm('Delete this class?')">
                  <button class="btn sm danger" type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </form>
</div>

<script>
  (function () {
    var all = document.getElementById('class-all');
    var picks = Array.prototype.slice.call(document.querySelectorAll('.class-pick'));
    var bar = document.getElementById('class-bulk-bar');
    var count = document.getElementById('class-count');
    function sync() {
      var n = picks.filter(function (p) { return p.checked; }).length;
      count.textContent = n;
      bar.hidden = n === 0;
      if (all) { all.checked = n > 0 && n === picks.length; all.indeterminate = n > 0 && n < picks.length; }
    }
    if (all) all.addEventListener('change', function () {
      picks.forEach(function (p) { p.checked = all.checked; });
      sync();
    });
    picks.forEach(function (p) { p.addEventListener('change', sync); });
    sync();
  })();
</script>

<%- include('../partials/foot') %>
