<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>

<div class="card">
  <div class="card-head">
    <div>
      <h1>Email</h1>
      <div class="muted small">
        Parents get an email for every booking, cancellation and move; teachers get a copy when a parent books or cancels.
        Enter your mail server here and it takes effect immediately — no redeploy.
      </div>
    </div>
    <div class="spacer"></div>
    <span class="badge <%= cfg.enabled ? 'ok' : 'muted' %>"><%= cfg.provider === 'smtp' ? 'SMTP' : cfg.provider === 'graph' ? 'Microsoft 365' : 'Not configured' %></span>
  </div>

  <% if (cfg.provider === 'graph') { %>
    <div class="alert success" style="margin-bottom:0">
      Sending through <strong>Microsoft 365</strong> as <span class="mono"><%= cfg.graph.sender %></span>, over HTTPS.
    </div>
  <% } else if (cfg.provider === 'smtp') { %>
    <div class="alert success" style="margin-bottom:0">
      Sending through <span class="mono"><%= cfg.smtp.host %>:<%= cfg.smtp.port %></span> as
      <strong><%= cfg.smtp.fromName %></strong> &lt;<span class="mono"><%= cfg.smtp.from %></span>&gt;.
    </div>
  <% } else { %>
    <div class="alert info" style="margin-bottom:0">
      Email is off. Bookings still work and WhatsApp still goes out — every email is recorded as
      <span class="mono">skipped</span> in the message log until one of the two options below is set up.
    </div>
  <% } %>
</div>

<% if (typeof result !== 'undefined' && result) { %>
  <div class="card tight">
    <div class="alert <%= result.status === 'sent' ? 'success' : result.status === 'skipped' ? 'info' : 'error' %>" style="margin-bottom:0">
      <strong>Test <%= result.status %>.</strong> <%= result.detail %>
    </div>
  </div>
<% } %>

<form method="post" action="/admin/email" class="card">
  <h2>Microsoft 365 <span class="muted small">— recommended</span></h2>
  <p class="muted small">
    Sends through Microsoft Graph over HTTPS, so it works from any host. (Railway blocks outgoing SMTP on its
    Free, Trial and Hobby plans — a <em>connection timeout</em> on the SMTP test below is that, not a wrong password.)
  </p>

  <% if (graphApp.present) { %>
    <div class="alert info" style="margin-bottom:12px">
      Using the Entra app <span class="mono"><%= graphApp.clientId %></span><%= graphApp.fromEntra ? ' — the same one staff sign in with' : '' %>.
      It needs one more permission before it can send:
      <ol style="margin:8px 0 0 18px;padding:0">
        <li>Entra admin centre → <strong>App registrations</strong> → this app → <strong>API permissions</strong> → <strong>Add a permission</strong> → Microsoft Graph → <strong>Application permissions</strong> → tick <span class="mono">Mail.Send</span> → Add.</li>
        <li>Press <strong>Grant admin consent</strong> for the tenant.</li>
        <li>Enter the mailbox to send as, below, and <strong>Send a test</strong>.</li>
      </ol>
    </div>
  <% } else { %>
    <div class="alert error" style="margin-bottom:12px">
      No Entra app is configured. Set <span class="mono">ENTRA_TENANT_ID</span>, <span class="mono">ENTRA_CLIENT_ID</span> and
      <span class="mono">ENTRA_CLIENT_SECRET</span> on the host (or <span class="mono">GRAPH_*</span> for a separate app), then come back here.
    </div>
  <% } %>

  <div class="row">
    <div class="field">
      <label for="graph_sender">Send as (a Microsoft 365 mailbox) *</label>
      <input id="graph_sender" name="graph_sender" type="email" value="<%= fromForm.graph_sender %>" placeholder="appointments@aca.edu.kw">
      <div class="hint">A real, licensed mailbox in your tenant. A dedicated one such as <span class="mono">appointments@aca.edu.kw</span> is best — replies land somewhere the office watches, and nobody's password change breaks it. No password is needed here: the app sends on the mailbox's behalf.</div>
    </div>
  </div>

  <h2 style="margin-top:22px">Which one to use</h2>
  <div class="btn-row" style="gap:18px">
    <label class="check"><input type="radio" name="provider" value="" <%= !fromForm.provider ? 'checked' : '' %>> <span>Whichever is set up <span class="muted small">(Microsoft 365 first)</span></span></label>
    <label class="check"><input type="radio" name="provider" value="graph" <%= fromForm.provider === 'graph' ? 'checked' : '' %>> <span>Microsoft 365</span></label>
    <label class="check"><input type="radio" name="provider" value="smtp" <%= fromForm.provider === 'smtp' ? 'checked' : '' %>> <span>SMTP server</span></label>
  </div>

  <h2 style="margin-top:22px">Mail server (SMTP) <span class="muted small">— only if Microsoft 365 is not an option</span></h2>
  <div class="row">
    <div class="field">
      <label for="host">Server *</label>
      <input id="host" name="host" value="<%= fromForm.host %>" placeholder="smtp.office365.com">
      <div class="hint">Office 365: <span class="mono">smtp.office365.com</span> · Gmail / Google Workspace: <span class="mono">smtp.gmail.com</span></div>
    </div>
    <div class="field">
      <label for="port">Port</label>
      <input id="port" name="port" value="<%= fromForm.port %>" placeholder="587" inputmode="numeric">
      <div class="hint">587 with STARTTLS is usual. 465 is for servers that want TLS from the first byte.</div>
    </div>
  </div>
  <div class="row">
    <div class="field">
      <label class="check"><input type="checkbox" name="secure" value="1" <%= fromForm.secure ? 'checked' : '' %>>
        <span>Encrypted from the start (port 465). Leave off for 587.</span></label>
    </div>
    <div class="field">
      <label class="check"><input type="checkbox" name="verify_tls" value="1" <%= fromForm.verify_tls ? 'checked' : '' %>>
        <span>Check the server's certificate. Turn off only for a relay inside the school network.</span></label>
    </div>
  </div>

  <div class="row">
    <div class="field">
      <label for="user">Username</label>
      <input id="user" name="user" value="<%= fromForm.user %>" autocomplete="off" placeholder="appointments@aca.edu.kw">
      <div class="hint">Usually the full mailbox address. Leave blank for a relay that needs no sign-in.</div>
    </div>
    <div class="field">
      <label for="password">Password <%= passwordSet ? '' : '' %></label>
      <input id="password" name="password" type="password" autocomplete="new-password"
             placeholder="<%= passwordSet ? 'Stored — leave blank to keep it' : 'Mailbox or app password' %>">
      <div class="hint">
        Stored in the application database, never shown again.
        Office 365 and Gmail usually need an <em>app password</em>, not the normal sign-in one.
        <% if (passwordSet) { %>
          <label class="check" style="margin-top:8px"><input type="checkbox" name="clear_password" value="1"><span>Remove the stored password</span></label>
        <% } %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="field">
      <label for="from">Send from *</label>
      <input id="from" name="from" value="<%= fromForm.from %>" placeholder="appointments@aca.edu.kw">
      <div class="hint">What parents see as the sender. Most servers insist it matches the username's mailbox.</div>
    </div>
    <div class="field">
      <label for="from_name">Sender name</label>
      <input id="from_name" name="from_name" value="<%= fromForm.from_name %>" placeholder="<%= config.schoolName %>">
    </div>
  </div>

  <h2 style="margin-top:22px">Who is told</h2>
  <p class="muted small">Parents are always emailed. These control the teacher's copy.</p>
  <label class="check"><input type="checkbox" name="teacher_on_booking" value="1" <%= fromForm.teacher_on_booking ? 'checked' : '' %>>
    <span><strong>Teacher gets a copy when a parent books</strong> — with the student, the parent's phone and their note.</span></label>
  <label class="check" style="margin-top:6px"><input type="checkbox" name="teacher_on_cancel" value="1" <%= fromForm.teacher_on_cancel ? 'checked' : '' %>>
    <span><strong>Teacher is told when a parent or the office cancels</strong> — never for a cancellation they made themselves.</span></label>

  <div class="btn-row" style="margin-top:18px">
    <button class="btn" type="submit">Save settings</button>
    <% if (fromForm.host) { %>
      <label class="check" style="margin-left:12px"><input type="checkbox" name="clear_smtp" value="1"><span>Clear the SMTP settings</span></label>
    <% } %>
  </div>
</form>

<form method="post" action="/admin/email/test" class="card">
  <h2>Send a test</h2>
  <p class="muted small">
    Sends one real email through <strong><%= cfg.source %></strong> and records the attempt in the message log.
  </p>
  <div class="row">
    <div class="field">
      <label for="test_to">Send to</label>
      <input id="test_to" name="test_to" type="email" value="<%= testTo %>">
    </div>
  </div>
  <div class="btn-row"><button class="btn ghost" type="submit">Send test email</button></div>
</form>

<div class="card">
  <h2>Setting up a mailbox</h2>
  <div class="table-wrap">
    <table class="data">
      <thead><tr><th style="width:170px">Service</th><th>Server</th><th>Port</th><th>Notes</th></tr></thead>
      <tbody>
        <tr>
          <td>Microsoft 365</td><td class="mono">smtp.office365.com</td><td>587</td>
          <td class="small">Username is the mailbox address. The mailbox needs <em>Authenticated SMTP</em> enabled in the Microsoft 365 admin centre (Users → the mailbox → Mail → Manage email apps). With MFA on, use an app password.</td>
        </tr>
        <tr>
          <td>Google Workspace / Gmail</td><td class="mono">smtp.gmail.com</td><td>587</td>
          <td class="small">Turn on 2-step verification for the account, then create an <em>App password</em> and use that here.</td>
        </tr>
        <tr>
          <td>A relay on the school network</td><td class="small">its address</td><td>25 or 587</td>
          <td class="small">Often no username. If it presents a certificate for a different name, untick <em>Check the server's certificate</em>.</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="muted small" style="margin-top:10px">
    A dedicated mailbox such as <span class="mono">appointments@aca.edu.kw</span> is better than a person's: replies from parents land somewhere the office watches, and nobody's password change breaks the system.
  </p>
  <div class="btn-row" style="margin-top:10px"><a class="btn ghost sm" href="/admin/notifications">Open the message log</a></div>
</div>

<%- include('../partials/foot') %>
