<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>

<div class="card">
  <div class="card-head">
    <div>
      <h1><%= event.name %></h1>
      <div class="muted small">
        <%= (EVENT_TYPES[event.type] || {}).label %> ·
        <span class="mono"><%= config.baseUrl %>/e/<%= event.slug %></span>
      </div>
    </div>
    <div class="spacer"></div>
    <div class="btn-row">
      <a class="btn ghost sm" href="/admin/events/<%= event.id %>/report">Report</a>
      <a class="btn ghost sm" href="/admin/events/<%= event.id %>/export.csv">Bookings CSV</a>
      <a class="btn ghost sm" href="/admin/events/<%= event.id %>/unbooked.csv">Open slots CSV</a>
      <a class="btn ghost sm" href="/e/<%= event.slug %>" target="_blank">Preview</a>
    </div>
  </div>

  <div class="stat-row" style="margin-bottom:0">
    <div class="stat"><div class="n"><%= stats.booked %></div><div class="l">Booked</div></div>
    <div class="stat"><div class="n"><%= Math.max(0, stats.capacity - stats.booked) %></div><div class="l">Open slots</div></div>
    <div class="stat"><div class="n"><%= stats.cancelled %></div><div class="l">Cancelled</div></div>
    <div class="stat"><div class="n"><%= schedules.length %></div><div class="l">Schedules</div></div>
  </div>

  <form method="post" action="/admin/events/<%= event.id %>/status" class="btn-row" style="margin-top:16px">
    <span class="muted small">Status: <span class="badge <%= event.status === 'published' ? 'ok' : 'muted' %>"><%= event.status %></span></span>
    <select name="status" style="width:auto">
      <% ['draft','published','closed','archived'].forEach(function (s) { %>
        <option value="<%= s %>" <%= event.status === s ? 'selected' : '' %>><%= s %></option>
      <% }); %>
    </select>
    <button class="btn sm" type="submit">Update status</button>
    <span class="muted small">
      <% if (window.state === 'open') { %>Open to parents now.
      <% } else if (window.state === 'not_yet') { %>Opens <%= h.formatDate(window.opens) %>.
      <% } else if (window.state === 'closed') { %>Closed to new bookings.
      <% } else { %>Not visible to parents.<% } %>
    </span>
  </form>
</div>

<% if (event.type === 'conference') { %>
<form method="post" action="/admin/events/<%= event.id %>/schedules/generate" class="card">
  <h2>Create schedules from classes</h2>
  <p class="muted small">One schedule per active class, for every teacher in the departments you tick. Safe to re-run — existing schedules are left alone.</p>
  <div class="grid three">
    <% departments.forEach(function (d) { %>
      <label class="check"><input type="checkbox" name="department_ids" value="<%= d.id %>"><label for=""><%= d.name %></label></label>
    <% }); %>
  </div>
  <% if (!departments.length) { %><p class="muted small">No departments on this campus yet.</p><% } %>
  <div class="row">
    <div class="field">
      <label>Default mode</label>
      <select name="mode"><% Object.keys(MODES).forEach(function (m) { %><option value="<%= m %>"><%= MODES[m] %></option><% }); %></select>
    </div>
    <div class="field"><label>Default location</label><input name="location" placeholder="Classroom"></div>
  </div>
  <button class="btn" type="submit">Create schedules</button>
</form>
<% } %>

<form method="post" action="/admin/events/<%= event.id %>/schedules" class="card">
  <h2>Add a single schedule</h2>
  <p class="muted small">Use this for a uniform counter, an admissions desk, or one extra teacher.</p>
  <div class="row">
    <div class="field"><label>Label</label><input name="label" placeholder="Uniform counter 1"></div>
    <div class="field">
      <label>Owner (staff)</label>
      <select name="staff_id">
        <option value="">— none —</option>
        <% teachers.forEach(function (t) { %><option value="<%= t.id %>"><%= t.name %> (<%= t.role %>)</option><% }); %>
      </select>
    </div>
    <div class="field">
      <label>Department</label>
      <select name="department_id">
        <option value="">—</option>
        <% departments.forEach(function (d) { %><option value="<%= d.id %>"><%= d.name %></option><% }); %>
      </select>
    </div>
    <div class="field">
      <label>Mode</label>
      <select name="mode"><% Object.keys(MODES).forEach(function (m) { %><option value="<%= m %>"><%= MODES[m] %></option><% }); %></select>
    </div>
  </div>
  <div class="row">
    <div class="field"><label>Location</label><input name="location"></div>
    <div class="field"><label>Video link</label><input name="meeting_link" type="url"></div>
  </div>
  <button class="btn" type="submit">Add schedule</button>
</form>

<%
  // Group the event's schedules by department — both slot tools pick from this.
  var groups = [];
  schedules.forEach(function (s) {
    var key = s.department_id || 0;
    var g = groups.find(function (x) { return x.key === key; });
    if (!g) {
      g = { key: key, name: s.department_name || 'No department', id: s.department_id, items: [] };
      groups.push(g);
    }
    g.items.push(s);
  });
%>

<form method="post" action="/admin/events/<%= event.id %>/slots/bulk" class="card">
  <h2>Generate slots across schedules</h2>
  <p class="muted small">Roll the same pattern over every schedule you tick. Duplicate times are skipped, so this is safe to run again after adding a teacher.</p>

  <div class="row">
    <div class="field"><label>Dates *</label><input name="dates" placeholder="2026-10-05, 2026-10-06" required><div class="hint">YYYY-MM-DD, comma separated.</div></div>
    <div class="field"><label>Start *</label><input name="start_time" type="time" value="15:00" required></div>
    <div class="field"><label>End *</label><input name="end_time" type="time" value="18:00" required></div>
  </div>
  <div class="row">
    <div class="field"><label>Minutes each *</label><input name="duration" type="number" min="5" value="10" required></div>
    <div class="field"><label>Gap (min)</label><input name="gap" type="number" min="0" value="0"></div>
    <div class="field"><label>Parents per slot</label><input name="capacity" type="number" min="1" value="1"><div class="hint">Use more than 1 for a walk-up counter.</div></div>
  </div>
  <fieldset>
    <legend>Break (optional)</legend>
    <div class="row">
      <div class="field"><label>From</label><input name="break_start" type="time"></div>
      <div class="field"><label>To</label><input name="break_end" type="time"></div>
      <div class="field"><label>Label</label><input name="break_label" placeholder="Maghrib prayer"></div>
    </div>
  </fieldset>

  <h3>Apply to</h3>
  <p class="muted small">
    Tick a <strong>department</strong> to cover every teacher in it — including any teacher added later.
    Or open a department and pick individual schedules.
  </p>
  <div class="btn-row" style="margin-bottom:10px">
    <button class="btn sm ghost" type="button" data-select="all">Select all departments</button>
    <button class="btn sm ghost" type="button" data-select="none">Clear</button>
  </div>

  <div class="dept-picker" data-picker data-dept-name="slot_department_ids" data-sched-name="schedule_ids">
    <% groups.forEach(function (g) { %>
      <div class="dept-group">
        <label class="check dept-head">
          <input type="checkbox" name="slot_department_ids" value="<%= g.id || '' %>"
                 data-dept="<%= g.key %>" <%= g.id ? '' : 'disabled title="Schedules with no department must be picked individually"' %>>
          <span>
            <strong><%= g.name %></strong>
            <span class="muted small">— <%= g.items.length %> schedule<%= g.items.length === 1 ? '' : 's' %>,
              <%= [...new Set(g.items.map(function (i) { return i.staff_id; }).filter(Boolean))].length %> teacher(s)</span>
          </span>
        </label>
        <details>
          <summary class="muted small">Show schedules</summary>
          <div class="grid three" style="padding:10px 0 4px">
            <% g.items.forEach(function (s) { %>
              <label class="check">
                <input type="checkbox" name="schedule_ids" value="<%= s.id %>" data-in-dept="<%= g.key %>">
                <span><%= s.display_name %><br><span class="muted small"><%= s.staff_name || '' %> · <%= s.stats.total_slots %> slots</span></span>
              </label>
            <% }); %>
          </div>
        </details>
      </div>
    <% }); %>
  </div>

  <% if (!schedules.length) { %><p class="muted small">Create schedules first.</p><% } %>
  <div class="btn-row" style="margin-top:14px"><button class="btn" type="submit">Generate slots</button></div>
</form>

<div class="card" id="slot-tools">
  <h2>Change or remove slots</h2>
  <p class="muted small">
    The other side of the tool above: pick the same departments, say which dates and times you mean,
    and either take those slots away or just close them. Leave the dates blank and it covers every
    slot these schedules hold in this event.
  </p>

  <% if (preview) { %>
    <div class="alert <%= preview.counts.booked ? 'warn' : 'info' %>">
      <strong>
        <%= preview.counts.slots %> slot<%= preview.counts.slots === 1 ? '' : 's' %>
        across <%= preview.counts.schedules %> schedule<%= preview.counts.schedules === 1 ? '' : 's' %> match.
      </strong>
      <% if (preview.counts.booked) { %>
        <%= preview.counts.booked %> of them <%= preview.counts.booked === 1 ? 'holds a booking' : 'hold bookings' %>.
      <% } else { %>
        None of them is booked.
      <% } %>
      <% if (preview.counts.blocked) { %> <%= preview.counts.blocked %> already closed.<% } %>
      <% if (preview.byDate.length) { %>
        <div class="table-wrap" style="margin-top:10px">
          <table class="data">
            <thead><tr><th>Date</th><th>Slots</th><th>Booked</th><th>Closed</th></tr></thead>
            <tbody>
              <% preview.byDate.forEach(function (d) { %>
                <tr><td><%= h.formatDate(d.date) %></td><td><%= d.slots %></td><td><%= d.booked %></td><td><%= d.blocked %></td></tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
      <div class="muted small" style="margin-top:8px">
        Your picks are still in the form below — set the action and confirm, or change the filter and check again.
      </div>
    </div>
  <% } %>

  <form method="post" action="/admin/events/<%= event.id %>/slots/edit" id="slot-edit-form">
    <div class="row">
      <div class="field">
        <label for="edit_dates">Dates</label>
        <input id="edit_dates" name="dates" placeholder="every date"
               value="<%= preview ? preview.form.dates : '' %>">
        <div class="hint">YYYY-MM-DD, comma separated. Blank means every date.</div>
      </div>
      <div class="field">
        <label for="edit_from">From</label>
        <input id="edit_from" name="from_time" type="time" value="<%= preview ? preview.form.from_time : '' %>">
        <div class="hint">Slots starting at or after this time.</div>
      </div>
      <div class="field">
        <label for="edit_to">Until</label>
        <input id="edit_to" name="to_time" type="time" value="<%= preview ? preview.form.to_time : '' %>">
        <div class="hint">Slots starting before this time.</div>
      </div>
    </div>

    <h3>Apply to</h3>
    <div class="btn-row" style="margin-bottom:10px">
      <button class="btn sm ghost" type="button" data-select="all">Select all departments</button>
      <button class="btn sm ghost" type="button" data-select="none">Clear</button>
    </div>

    <div class="dept-picker" data-picker data-dept-name="department_ids" data-sched-name="schedule_ids">
      <% groups.forEach(function (g) { %>
        <div class="dept-group">
          <label class="check dept-head">
            <input type="checkbox" name="department_ids" value="<%= g.id || '' %>" data-dept="<%= g.key %>"
                   <%= g.id ? '' : 'disabled title="Schedules with no department must be picked individually"' %>
                   <%= preview && g.id && preview.form.department_ids.indexOf(g.id) !== -1 ? 'checked' : '' %>>
            <span>
              <strong><%= g.name %></strong>
              <span class="muted small">— <%= g.items.reduce(function (a, i) { return a + i.stats.total_slots; }, 0) %> slots</span>
            </span>
          </label>
          <details>
            <summary class="muted small">Show schedules</summary>
            <div class="grid three" style="padding:10px 0 4px">
              <% g.items.forEach(function (s) { %>
                <label class="check">
                  <input type="checkbox" name="schedule_ids" value="<%= s.id %>" data-in-dept="<%= g.key %>"
                         <%= preview && preview.form.schedule_ids.indexOf(s.id) !== -1 ? 'checked' : '' %>>
                  <span><%= s.display_name %><br><span class="muted small"><%= s.stats.total_slots %> slots · <%= s.stats.booked %> booked</span></span>
                </label>
              <% }); %>
            </div>
          </details>
        </div>
      <% }); %>
    </div>

    <% if (!schedules.length) { %><p class="muted small">Create schedules first.</p><% } %>

    <div class="danger-zone" style="margin-top:16px">
      <h3 style="margin-top:0">What to do with them</h3>
      <div class="btn-row" style="margin-bottom:10px">
        <label class="check"><input type="radio" name="action" value="delete" checked> <span><strong>Delete</strong> — remove the times entirely</span></label>
      </div>
      <div class="btn-row" style="margin-bottom:10px">
        <label class="check"><input type="radio" name="action" value="block"> <span><strong>Close</strong> — keep them, but no new sign-ups</span></label>
      </div>
      <div class="btn-row" style="margin-bottom:14px">
        <label class="check"><input type="radio" name="action" value="unblock"> <span><strong>Reopen</strong> — allow sign-ups again</span></label>
      </div>

      <label class="check"><input type="checkbox" name="cancel_bookings" value="1">
        <span>Cancel their bookings too — needed before deleting a slot a family already holds</span></label>
      <label class="check" style="margin-top:6px"><input type="checkbox" name="notify" value="1" checked>
        <span>Tell those parents their appointment was cancelled</span></label>

      <div class="btn-row" style="margin-top:14px">
        <button class="btn ghost" type="submit" formaction="/admin/events/<%= event.id %>/slots/preview">Check what this matches</button>
        <button class="btn danger" type="submit">Apply to these slots</button>
      </div>
      <p class="muted small" style="margin-top:8px">
        Closing a slot someone already holds is skipped rather than done quietly — cancel the booking first.
      </p>
    </div>
  </form>
</div>

<script>
  /* Each picker works only inside its own form, so the two slot tools on this
     page cannot tick each other's boxes. */
  document.querySelectorAll('[data-picker]').forEach(function (picker) {
    var form = picker.closest('form');
    var deptName = picker.dataset.deptName;
    var schedName = picker.dataset.schedName;
    var depts = picker.querySelectorAll('input[name="' + deptName + '"]');
    var scheds = picker.querySelectorAll('input[name="' + schedName + '"]');

    function childrenOf(key) {
      return picker.querySelectorAll('input[name="' + schedName + '"][data-in-dept="' + key + '"]');
    }
    depts.forEach(function (d) {
      d.addEventListener('change', function () {
        childrenOf(d.dataset.dept).forEach(function (c) { c.checked = d.checked; });
      });
    });
    // Unticking one teacher releases the whole-department tick, so exclusions stick.
    scheds.forEach(function (c) {
      c.addEventListener('change', function () {
        if (c.checked) return;
        var d = picker.querySelector('input[name="' + deptName + '"][data-dept="' + c.dataset.inDept + '"]');
        if (d) d.checked = false;
      });
    });
    (form ? form.querySelectorAll('[data-select]') : []).forEach(function (b) {
      b.addEventListener('click', function () {
        var on = b.dataset.select === 'all';
        depts.forEach(function (d) {
          if (d.disabled) return;
          d.checked = on;
          childrenOf(d.dataset.dept).forEach(function (c) { c.checked = on; });
        });
        if (!on) scheds.forEach(function (c) { c.checked = false; });
      });
    });
  });

  /* Deleting is the default action and the one that cannot be undone. */
  (function () {
    var form = document.getElementById('slot-edit-form');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      if (e.submitter && /preview$/.test(e.submitter.getAttribute('formaction') || '')) return;
      var action = form.querySelector('input[name=action]:checked');
      if (!action || action.value !== 'delete') return;
      if (!window.confirm('Delete the matching slots? This cannot be undone.')) e.preventDefault();
    });
  })();
</script>

<div class="card">
  <h2>Schedules (<%= schedules.length %>)</h2>
  <div class="table-wrap">
    <table class="data">
      <thead><tr><th>Schedule</th><th>Owner</th><th>Department</th><th>Slots</th><th>Booked</th><th>State</th><th></th></tr></thead>
      <tbody>
        <% schedules.forEach(function (s) { %>
          <tr>
            <td><a href="/staff/schedule/<%= s.id %>"><strong><%= s.display_name %></strong></a></td>
            <td class="small"><%= s.staff_name || '—' %></td>
            <td class="small"><%= s.department_name || '—' %></td>
            <td><%= s.stats.total_slots %></td>
            <td><%= s.stats.booked %> <span class="muted small">/ <%= s.stats.capacity %></span></td>
            <td><% if (s.locked) { %><span class="badge bad">locked</span><% } else { %><span class="badge ok">open</span><% } %></td>
            <td style="text-align:end">
              <% if (s.stats.booked > 0) { %>
                <details>
                  <summary class="btn sm danger" style="display:inline-flex">Delete…</summary>
                  <form method="post" action="/admin/schedules/<%= s.id %>/delete" style="text-align:start;padding:10px 0"
                        onsubmit="return confirm('Cancel <%= s.stats.booked %> booking(s) and delete this schedule?')">
                    <div class="check">
                      <input type="checkbox" id="cb<%= s.id %>" name="cancel_bookings" value="1" required>
                      <label for="cb<%= s.id %>">Cancel its <%= s.stats.booked %> booking(s) too</label>
                    </div>
                    <div class="check">
                      <input type="checkbox" id="nt<%= s.id %>" name="notify" value="1" checked>
                      <label for="nt<%= s.id %>">Tell the parents</label>
                    </div>
                    <button class="btn sm danger" type="submit">Delete schedule</button>
                  </form>
                </details>
              <% } else { %>
                <form method="post" action="/admin/schedules/<%= s.id %>/delete"
                      onsubmit="return confirm('Delete this schedule and its empty slots?')">
                  <button class="btn sm danger" type="submit">Delete</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<form method="post" action="/admin/events/<%= event.id %>" class="card">
  <h2>Event settings</h2>
  <div class="row">
    <div class="field"><label>Name</label><input name="name" value="<%= event.name %>" required></div>
    <div class="field"><label>Arabic name</label><input name="name_ar" value="<%= event.name_ar || '' %>"></div>
  </div>
  <div class="field"><label>Short description</label><input name="description" value="<%= event.description || '' %>"></div>
  <div class="field"><label>Instructions for parents</label><textarea name="instructions"><%= event.instructions || '' %></textarea></div>
  <div class="row">
    <div class="field"><label>Booking opens</label><input name="opens_at" type="datetime-local" value="<%= (event.opens_at || '').replace(' ', 'T') %>"></div>
    <div class="field"><label>Booking closes</label><input name="closes_at" type="datetime-local" value="<%= (event.closes_at || '').replace(' ', 'T') %>"></div>
  </div>
  <div class="row">
    <div class="field"><label>Max per student (0 = unlimited)</label><input name="max_per_student" type="number" min="0" value="<%= event.max_per_student %>"></div>
    <div class="field"><label>Cancellation cutoff (hours)</label><input name="cancel_cutoff_hrs" type="number" min="0" value="<%= event.cancel_cutoff_hrs %>"></div>
  </div>
  <div class="check"><input type="checkbox" id="e_po" name="prevent_overlap" <%= event.prevent_overlap ? 'checked' : '' %>><label for="e_po">Block overlapping times for one family</label></div>
  <div class="check"><input type="checkbox" id="e_ac" name="allow_cancel" <%= event.allow_cancel ? 'checked' : '' %>><label for="e_ac">Let parents cancel online</label></div>
  <div class="check"><input type="checkbox" id="e_rp" name="require_phone" <%= event.require_phone ? 'checked' : '' %>><label for="e_rp">Require a mobile number</label></div>
  <div class="check"><input type="checkbox" id="e_cs" name="collect_student" <%= event.collect_student ? 'checked' : '' %>><label for="e_cs">Ask for student name and grade</label></div>
  <div class="check"><input type="checkbox" id="e_cmp" name="allow_compare" <%= event.allow_compare ? 'checked' : '' %>><label for="e_cmp">Offer the side-by-side comparison grid to parents</label></div>
  <button class="btn" type="submit">Save settings</button>
</form>

<% if (user.role === 'admin') { %>
  <div class="card danger-zone">
    <h2>Delete this event</h2>
    <p class="muted small">
      Removes the event, its <%= schedules.length %> schedule(s), every slot and every booking record.
      To simply stop new sign-ups, set the status to <span class="mono">closed</span> above instead — that keeps the
      history and parents' links working.
    </p>
    <a class="btn danger" href="/admin/events/<%= event.id %>/delete">Delete event…</a>
  </div>
<% } %>

<%- include('../partials/foot') %>
