<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>

<% if (storage.ephemeral) { %>
  <div class="alert error">
    <strong>Your data will be lost on the next deploy.</strong>
    The database is at <span class="mono"><%= storage.path %></span>, inside the application folder —
    container hosts rebuild that folder every time you deploy.
    Mount a persistent volume (on Railway: Settings → Volumes → Add, mount path <span class="mono">/data</span>)
    and set <span class="mono">DATABASE_PATH=/data/app.db</span>, then redeploy.
  </div>
<% } %>

<div class="stat-row">
  <div class="stat"><div class="n"><%= counts.campuses %></div><div class="l">Campuses</div></div>
  <div class="stat"><div class="n"><%= counts.staff %></div><div class="l">Active staff</div></div>
  <div class="stat"><div class="n"><%= counts.bookings %></div><div class="l">Live bookings</div></div>
</div>

<div class="card">
  <div class="card-head">
    <h2><%= showArchived ? 'Archived events' : 'Events' %></h2>
    <div class="spacer"></div>
    <% if (showArchived) { %>
      <a class="btn sm ghost" href="/admin">‹ Current events</a>
    <% } else if (archivedCount > 0) { %>
      <a class="btn sm ghost" href="/admin?archived=1">Archived (<%= archivedCount %>)</a>
    <% } %>
    <a class="btn sm" href="/admin/events/new">+ New event</a>
  </div>

  <% if (showArchived) { %>
    <p class="muted small">Archived events keep every schedule, slot and booking. Open one and change its status back to <span class="mono">closed</span> or <span class="mono">published</span> to bring it back; its report and CSV still work while archived.</p>
  <% } %>

  <% if (!events.length) { %>
    <p class="muted small"><%= showArchived ? 'Nothing has been archived.' : 'No events yet. Create one, add the schedules parents book against, then publish it.' %></p>
  <% } else { %>
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th>Event</th><th>Campus</th><th>Type</th><th>Status</th><th>Schedules</th><th>Booked</th><th></th></tr></thead>
        <tbody>
          <% events.forEach(function (e) { %>
            <tr>
              <td><a href="/admin/events/<%= e.id %>"><strong><%= e.name %></strong></a><br><span class="muted small mono">/e/<%= e.slug %></span></td>
              <td><%= e.campus_name %></td>
              <td><%= (EVENT_TYPES[e.type] || {}).label || e.type %></td>
              <td>
                <span class="badge <%= e.status === 'published' ? 'ok' : e.status === 'closed' ? 'warn' : 'muted' %>"><%= e.status %></span>
              </td>
              <td><%= e.schedules %></td>
              <td><%= e.bookings %> <span class="muted small">/ <%= e.capacity %></span></td>
              <td style="white-space:nowrap">
                <a class="btn sm ghost" href="/admin/events/<%= e.id %>/report">Report</a>
                <% if (e.status === 'published') { %><a class="btn sm ghost" href="/e/<%= e.slug %>" target="_blank">Open</a><% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="card tight">
  <div class="btn-row">
    <div>
      <strong class="small">Back-up</strong>
      <div class="muted small">Downloads the whole database as one file. Safe to run while parents are booking.</div>
    </div>
    <div class="spacer" style="margin-inline-start:auto"></div>
    <% if (user.role === 'admin') { %>
      <a class="btn ghost sm" href="/admin/backup.db">Download database</a>
    <% } %>
  </div>
</div>

<%- include('../partials/foot') %>
