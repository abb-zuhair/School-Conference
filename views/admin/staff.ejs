<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>

<div class="card">
  <div class="card-head">
    <h1>Staff</h1>
    <div class="spacer"></div>
    <form method="get" action="/admin/staff" class="btn-row">
      <input name="q" value="<%= q %>" placeholder="Search name or email" style="width:220px">
      <button class="btn sm ghost" type="submit">Search</button>
    </form>
  </div>

  <form method="post" action="/admin/staff/bulk" id="bulk-staff">
  <div class="bulk-bar" id="staff-bulk-bar" hidden>
    <strong class="small"><span id="staff-count">0</span> selected</strong>

    <label class="small">Move to campus
      <select name="campus_id" style="width:auto">
        <option value="">— none —</option>
        <% campuses.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %></option><% }); %>
      </select>
    </label>
    <button class="btn sm" type="submit" name="action" value="campus">Apply</button>

    <label class="small">Move to department
      <select name="department_id" style="width:auto">
        <option value="">— none —</option>
        <% departments.forEach(function (d) { %><option value="<%= d.id %>"><%= d.name %></option><% }); %>
      </select>
    </label>
    <button class="btn sm" type="submit" name="action" value="department">Apply</button>

    <span class="bulk-sep"></span>
    <button class="btn sm ghost" type="submit" name="action" value="activate">Activate</button>
    <button class="btn sm ghost" type="submit" name="action" value="deactivate">Deactivate</button>

    <details class="bulk-danger">
      <summary class="btn sm danger">Delete…</summary>
      <div class="bulk-danger-body">
        <p class="small muted" style="margin:0 0 8px">
          Deletes the staff records, their classes and schedules. <strong>Deactivate instead</strong> if you only want to stop them signing in — that keeps past bookings intact.
        </p>
        <div class="check">
          <input type="checkbox" id="bulk_cancel" name="cancel_bookings" value="1">
          <label for="bulk_cancel">Cancel their live bookings too</label>
        </div>
        <div class="check">
          <input type="checkbox" id="bulk_notify" name="notify" value="1" checked>
          <label for="bulk_notify">Tell the affected parents</label>
        </div>
        <button class="btn sm danger" type="submit" name="action" value="delete"
                onclick="return confirm('Delete the selected staff permanently?')">Delete selected staff</button>
      </div>
    </details>
  </div>

  <div class="table-wrap">
    <table class="data">
      <thead><tr>
        <th style="width:34px"><input type="checkbox" id="staff-all" aria-label="Select all"></th>
        <th>Name</th><th>Email</th><th>Campus</th><th>Department</th><th>Role</th><th>Classes</th><th></th>
      </tr></thead>
      <tbody>
        <% staff.forEach(function (s) { %>
          <tr style="<%= s.active ? '' : 'opacity:.5' %>">
            <td><input type="checkbox" class="staff-pick" name="staff_ids" value="<%= s.id %>" form="bulk-staff"></td>
            <td><a href="/admin/staff/<%= s.id %>"><strong><%= s.name %></strong></a><% if (s.title) { %><br><span class="muted small"><%= s.title %></span><% } %></td>
            <td class="small mono"><%= s.email %></td>
            <td class="small"><%= s.campus_name || '—' %></td>
            <td class="small"><%= s.department_name || '—' %></td>
            <td><span class="badge <%= ['admin','campus_admin'].includes(s.role) ? 'warn' : 'muted' %>"><%= s.role %></span></td>
            <td><%= s.class_count %></td>
            <td style="white-space:nowrap">
              <form method="post" action="/admin/staff/<%= s.id %>/reset-password" style="display:inline" onsubmit="return confirm('Issue a new temporary password?')">
                <button class="btn sm ghost" type="submit">Reset password</button>
              </form>
              <form method="post" action="/admin/staff/<%= s.id %>/toggle" style="display:inline">
                <button class="btn sm ghost" type="submit"><%= s.active ? 'Deactivate' : 'Activate' %></button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  </form>
</div>

<script>
  (function () {
    var all = document.getElementById('staff-all');
    var picks = Array.prototype.slice.call(document.querySelectorAll('.staff-pick'));
    var bar = document.getElementById('staff-bulk-bar');
    var count = document.getElementById('staff-count');
    function sync() {
      var n = picks.filter(function (p) { return p.checked; }).length;
      count.textContent = n;
      bar.hidden = n === 0;
      if (all) all.checked = n > 0 && n === picks.length;
      if (all) all.indeterminate = n > 0 && n < picks.length;
    }
    if (all) all.addEventListener('change', function () {
      picks.forEach(function (p) { p.checked = all.checked; });
      sync();
    });
    picks.forEach(function (p) { p.addEventListener('change', sync); });
    sync();
  })();
</script>

<form method="post" action="/admin/staff" class="card">
  <h2>Add or update a staff member</h2>
  <p class="muted small">Entering an existing email updates that record instead of creating a duplicate.</p>
  <div class="row">
    <div class="field"><label>Full name *</label><input name="name" required></div>
    <div class="field"><label>School email *</label><input name="email" type="email" required></div>
    <div class="field"><label>Mobile</label><input name="phone"></div>
  </div>
  <div class="row">
    <div class="field"><label>Job title</label><input name="title" placeholder="Grade 6 Mathematics"></div>
    <div class="field">
      <label>Campus</label>
      <select name="campus_id">
        <option value="">—</option>
        <% campuses.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %></option><% }); %>
      </select>
    </div>
    <div class="field">
      <label>Department</label>
      <select name="department_id">
        <option value="">—</option>
        <% departments.forEach(function (d) { %><option value="<%= d.id %>"><%= d.name %></option><% }); %>
      </select>
    </div>
    <div class="field">
      <label>Role</label>
      <select name="role">
        <% roles.forEach(function (r) { %><option value="<%= r %>" <%= r === 'teacher' ? 'selected' : '' %>><%= r %></option><% }); %>
      </select>
    </div>
  </div>
  <button class="btn" type="submit">Save staff member</button>
</form>

<form method="post" action="/admin/classes" class="card">
  <h2>Add a class</h2>
  <div class="row">
    <div class="field">
      <label>Teacher *</label>
      <select name="staff_id" required>
        <option value="">Choose…</option>
        <% staff.filter(function (s) { return s.active; }).forEach(function (s) { %>
          <option value="<%= s.id %>"><%= s.name %> — <%= s.email %></option>
        <% }); %>
      </select>
    </div>
    <div class="field"><label>Class name *</label><input name="name" required placeholder="Grade 6B — Mathematics"></div>
    <div class="field"><label>Grade</label><input name="grade_level" placeholder="6"></div>
    <div class="field"><label>Room</label><input name="room" placeholder="B-204"></div>
  </div>
  <button class="btn" type="submit">Add class</button>
</form>

<%- include('../partials/foot') %>
