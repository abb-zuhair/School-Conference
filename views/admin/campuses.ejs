<%- include('../partials/head') %>
<%- include('../partials/admin-nav') %>

<h1>Campuses &amp; departments</h1>

<% campuses.forEach(function (c) { %>
  <div class="card">
    <div class="card-head">
      <div>
        <h2><%= c.name %> <% if (!c.active) { %><span class="badge muted">hidden</span><% } %></h2>
        <div class="muted small mono">/c/<%= c.slug %> · <%= c.staff_count %> staff</div>
      </div>
    </div>

    <details>
      <summary class="muted small" style="cursor:pointer;margin-bottom:10px">Edit campus details</summary>
      <form method="post" action="/admin/campuses/<%= c.id %>">
        <div class="row">
          <div class="field"><label>Name</label><input name="name" value="<%= c.name %>" required></div>
          <div class="field"><label>Name (Arabic)</label><input name="name_ar" value="<%= c.name_ar || '' %>"></div>
          <div class="field"><label>Sort order</label><input name="sort_order" type="number" value="<%= c.sort_order %>"></div>
        </div>
        <div class="row">
          <div class="field"><label>Address</label><input name="address" value="<%= c.address || '' %>"></div>
          <div class="field"><label>Phone</label><input name="phone" value="<%= c.phone || '' %>"></div>
        </div>
        <div class="check"><input type="checkbox" id="act<%= c.id %>" name="active" <%= c.active ? 'checked' : '' %>><label for="act<%= c.id %>">Visible to parents</label></div>
        <button class="btn sm" type="submit">Save campus</button>
      </form>
    </details>

    <h3 style="margin-top:18px">Departments</h3>
    <% if (!c.departments.length) { %><p class="muted small">No departments yet.</p><% } %>
    <div class="table-wrap">
      <table class="data">
        <tbody>
          <% c.departments.forEach(function (d) { %>
            <tr>
              <td><strong><%= d.name %></strong> <% if (d.name_ar) { %><span class="muted small"><%= d.name_ar %></span><% } %></td>
              <td style="width:80px" class="muted small">#<%= d.sort_order %></td>
              <td style="width:90px;text-align:end">
                <form method="post" action="/admin/departments/<%= d.id %>/delete" onsubmit="return confirm('Delete this department?')">
                  <button class="btn sm danger" type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <form method="post" action="/admin/departments" style="margin-top:12px">
      <input type="hidden" name="campus_id" value="<%= c.id %>">
      <div class="row">
        <div class="field"><label>New department</label><input name="name" placeholder="Elementary — Mathematics" required></div>
        <div class="field"><label>Arabic name</label><input name="name_ar"></div>
        <div class="field"><label>Sort order</label><input name="sort_order" type="number" value="0"></div>
      </div>
      <button class="btn sm ghost" type="submit">Add department</button>
    </form>
  </div>
<% }); %>

<% if (user.role === 'admin') { %>
  <form method="post" action="/admin/campuses" class="card">
    <h2>Add a campus</h2>
    <div class="row">
      <div class="field"><label>Name *</label><input name="name" required placeholder="ACA Hawally"></div>
      <div class="field"><label>Arabic name</label><input name="name_ar"></div>
      <div class="field"><label>URL slug</label><input name="slug" placeholder="hawally"></div>
    </div>
    <div class="row">
      <div class="field"><label>Address</label><input name="address"></div>
      <div class="field"><label>Phone</label><input name="phone"></div>
      <div class="field"><label>Sort order</label><input name="sort_order" type="number" value="0"></div>
    </div>
    <button class="btn" type="submit">Add campus</button>
  </form>
<% } %>

<%- include('../partials/foot') %>
