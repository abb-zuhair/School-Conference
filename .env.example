# ---- Core ----
PORT=3000
NODE_ENV=production
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Public base URL, used to build booking/cancel links inside emails & WhatsApp
BASE_URL=https://appointments.aca.edu.kw
# SQLite file. On Railway, mount a Volume at /data and point this at it.
DATABASE_PATH=./data/app.db
SCHOOL_TIMEZONE=Asia/Kuwait
SCHOOL_NAME=American Creativity Academy
SUPPORT_EMAIL=it@aca.edu.kw

# ---- First admin account (created on first run only) ----
ADMIN_EMAIL=zuhair@sama.com.kw
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_NAME=Zuhair

# ---- Staff sign-in with Microsoft 365 (Entra ID SSO) ----
# Entra app registration, Web platform, redirect URI:
#   https://<your BASE_URL>/auth/microsoft/callback
# Delegated permissions: openid, profile, email, User.Read (default consent is enough).
# Leave blank to hide the Microsoft button and use passwords only.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Only set these if you need to override the defaults:
#   ENTRA_REDIRECT_URI  — defaults to BASE_URL + /auth/microsoft/callback
#   ENTRA_AUTHORITY     — sovereign clouds only (default https://login.microsoftonline.com)
# Anyone in the tenant without a staff record is refused by default. Set true to
# create a teacher account automatically on first sign-in instead.
ENTRA_AUTO_CREATE=false
ENTRA_AUTO_CREATE_ROLE=teacher

# ---- Email via Microsoft Graph (app-only / client credentials) ----
# This is a SEPARATE app registration concern from SSO above: sending mail needs
# an Application permission, signing in needs Delegated. One app registration can
# hold both — GRAPH_TENANT_ID is reused as ENTRA_TENANT_ID when that is blank.
# Entra app needs Application permission Mail.Send (admin consented).
# Leave blank to disable email; the app logs a skipped notification instead.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Mailbox the confirmations are sent from (must exist in the tenant)
GRAPH_SENDER=noreply@aca.edu.kw

# ---- WhatsApp via WATI ----
# Leave blank to disable WhatsApp.
WATI_API_ENDPOINT=https://live-server-XXXX.wati.io
WATI_ACCESS_TOKEN=
# Approved WATI template names + the order of their {{1}}, {{2}} ... parameters
# is documented in README.md. Leave a name blank to skip that message type.
WATI_TEMPLATE_CONFIRM=appointment_confirmed
WATI_TEMPLATE_CANCEL=appointment_cancelled
WATI_TEMPLATE_REMINDER=appointment_reminder
# Default country code prepended to local Kuwaiti numbers (no +)
DEFAULT_COUNTRY_CODE=965

# ---- Reminders ----
# Cron expression in SCHOOL_TIMEZONE. Default: every day at 18:00.
REMINDER_CRON=0 18 * * *
# Send a reminder this many hours before the appointment
REMINDER_HOURS_BEFORE=24
